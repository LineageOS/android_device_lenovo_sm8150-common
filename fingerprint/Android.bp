cc_binary {
    name: "android.hardware.biometrics.fingerprint@2.3-service.lenovo_msmnile",
    relative_install_path: "hw",
    defaults: ["hidl_defaults"],
    init_rc: ["android.hardware.biometrics.fingerprint@2.3-service.lenovo_msmnile.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint@2.3-service.lenovo_msmnile.xml"],
    srcs: ["service.cpp", "BiometricsFingerprint.cpp"],
    shared_libs: [
        "libbase",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
        "libcutils",
        "android.hardware.biometrics.fingerprint@2.1",
        "android.hardware.biometrics.fingerprint@2.2",
        "android.hardware.biometrics.fingerprint@2.3",
        "vendor.goodix.extend.service@2.0",
        "vendor.goodix.extend.service@2.0_vendor",
    ],
    proprietary: true,
}

cc_library_static {
    name: "libudfps_extension.lenovo_msmnile",
    srcs: ["UdfpsExtension.cpp"],
    include_dirs: [
        "frameworks/native/services/surfaceflinger/CompositionEngine/include"
    ],
    header_libs: [
        "generated_kernel_headers",
    ],
}
